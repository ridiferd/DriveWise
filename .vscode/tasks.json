{
  "version": "2.0.0",
  "tasks": [
    { "label": "build", "command": "dotnet", "type": "process", "args": ["build", "${workspaceFolder}/DriveWise.sln"], "problemMatcher": "$msCompile", "group": { "kind": "build", "isDefault": true } },
    { "label": "test", "command": "dotnet", "type": "process", "args": ["test", "${workspaceFolder}/DriveWise.sln"], "problemMatcher": "$msCompile", "group": { "kind": "test", "isDefault": true } },
    { "label": "run (offline)", "command": "dotnet", "type": "process", "args": ["run", "--project", "${workspaceFolder}/src/DriveWise.Web"], "options": { "env": { "FuelEconomy__Mode": "Offline" } } }
  ]
}
